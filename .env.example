# ============================================================
# SahajVyapar — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# NEVER use NEXT_PUBLIC_ prefix on secrets (SUPERADMIN_KEY, service role, etc.)
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service role key — treat as highly sensitive; never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Razorpay ---
# Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
# Webhook secret — Dashboard → Webhooks → your endpoint → show secret
# ROTATE this key if it has ever appeared in source code or logs
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# --- Razorpay Subscription Plan IDs ---
# Create plans in Razorpay Dashboard → Products → Subscriptions → Plans
# If not set, the webhook will fall back to hardcoded IDs (which may not match your account)
RAZORPAY_PLAN_STARTER=plan_XXXXXXXXXXXXXXXX
RAZORPAY_PLAN_GROWTH=plan_XXXXXXXXXXXXXXXX
RAZORPAY_PLAN_PRO=plan_XXXXXXXXXXXXXXXX

# --- Resend (email) ---
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ADMIN_ALERT_EMAIL=your-admin-email@example.com

# --- Admin panel ---
# Secret for /admin routes — keep long and random; NEVER use NEXT_PUBLIC_ prefix
SUPERADMIN_KEY=generate-a-long-random-string-here

# --- App URL ---
NEXT_PUBLIC_APP_URL=https://yourdomain.com
